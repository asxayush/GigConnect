# ==============================================================================
# GIGCONNECT CLIENT ENVIRONMENT CONFIGURATION — EXAMPLE
# Copy this file to .env and fill in your values.
# Vite ONLY exposes variables prefixed with VITE_ to the browser bundle.
# ==============================================================================

# Backend API Endpoint
BACKEND_URL=http://localhost:4000
BACKEND_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
VITE_BACKEND_URL=http://localhost:4000
VITE_BACKEND_API_URL=http://localhost:4000

# Firebase Client Authentication (non-VITE_ kept for tooling compatibility)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# VITE_ aliases — required for Vite to expose these to import.meta.env in the browser
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Razorpay (test key from your Razorpay dashboard)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
