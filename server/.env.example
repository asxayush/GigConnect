PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gigconnect
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Firebase Admin: compact JSON service-account object
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Optional Twilio SMS notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Optional Razorpay test mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Cloudinary for persistent file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
